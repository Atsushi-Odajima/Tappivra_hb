{
  "name": "tappivra",
  "private": true,
  "version": "0.1.0",
  "description": "Tappivra — クリック体験デモ作成ツール（Windows 11 x64 エディター＋閲覧PWA）",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "build": "vite build",
    "samples": "playwright test --project=samples",
    "verify:release": "node scripts/verify-release.mjs",
    "package:release": "node scripts/package-release.mjs",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
