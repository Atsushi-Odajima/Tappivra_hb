{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tappivra main window: app commands only (no fs/shell/http plugins)",
  "windows": ["main"],
  "permissions": [
    "allow-list-projects",
    "allow-load-project",
    "allow-create-project",
    "allow-save-project",
    "allow-put-asset",
    "allow-get-asset",
    "allow-gc-assets",
    "allow-delete-project",
    "allow-delete-all",
    "allow-storage-usage",
    "allow-record-export",
    "allow-save-export"
  ]
}
